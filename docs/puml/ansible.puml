@startuml
top to bottom direction
namespace ansible {
    class "AnsibleInfo" << (S,Aquamarine) >> {
        + Cluster kubeclient.ClusterInfo
        + KubeconfigPath string

    }
    class "K3sConfig" << (S,Aquamarine) >> {
        + ServerIP string
        + DisableComponents string
        + CPUManagerPolicy string
        + SystemReservedCPU string
        + KubeReservedCPU string
        + SystemReservedMem string
        + KubeReservedMem string

    }
    class "template" << (S,Aquamarine) >> {
        - machineType string

    }
}


"ansible.AnsibleInfo""uses" o-- "kubeclient.ClusterInfo"


@enduml
