#cloud-config
autoinstall:
  version: 1

  locale: {{ .Locale }}

  keyboard:
    layout: {{ .Keymap }}

  identity:
    hostname: {{ .Hostname }}
    username: {{ .Username }}
    password: {{ .PasswordHash }}
    realname: {{ .UserFullname }}

  network:
    network:
      version: 2
      ethernets:
        {{ .Interface }}:
          dhcp4: true

  storage:
    layout:
      name: direct
    grub:
      reorder_uefi: false

  packages:
    - curl
    - wget
    - openssh-server
    - efibootmgr
    - {{ .ExtraPackages }}

  package_update: true
  package_upgrade: true

  late-commands:
    - mount -t efivarfs efivarfs /target/sys/firmware/efi/efivars || true
    - |
      curtin in-target --target=/target bash -c "
        DISK_ENTRY=\$(efibootmgr -v | grep -i 'ubuntu\|grub' | grep -oP 'Boot\K[0-9A-F]+' | head -1)
        efibootmgr --bootnext \$DISK_ENTRY || true
      "
    - |
      printf '[Unit]\nDescription=First Boot Ansible Trigger\nAfter=network-online.target\nWants=network-online.target\nConditionPathExists=/etc/first-boot-pending\n\n[Service]\nType=oneshot\nExecStart=/usr/local/bin/first-boot.sh\nRemainAfterExit=yes\n\n[Install]\nWantedBy=multi-user.target\n' > /target/etc/systemd/system/first-boot.service
    - |
      printf '#!/bin/bash\nwget -q -O /dev/null "http://{{ .CallbackHost }}/ansible?mac={{ .MACAddress }}"\nrm -f /etc/first-boot-pending\nsystemctl disable first-boot.service\n' > /target/usr/local/bin/first-boot.sh
    - chmod +x /target/usr/local/bin/first-boot.sh
    - touch /target/etc/first-boot-pending
    - curtin in-target --target=/target systemctl enable first-boot.service

  ssh:
    install-server: true
    allow-pw: false
    authorized-keys:
      - {{ .SSHPubKey }}
